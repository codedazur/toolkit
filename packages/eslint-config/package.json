{
  "name": "@codedazur/eslint-config",
  "version": "2.0.1",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cdk": {
      "types": "./dist/cdk.d.ts",
      "default": "./dist/cdk.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./sanity": {
      "types": "./dist/sanity.d.ts",
      "default": "./dist/sanity.js"
    },
    "./storybook": {
      "types": "./dist/storybook.d.ts",
      "default": "./dist/storybook.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "develop": "tsup --watch",
    "build": "tsup",
    "audit": "pnpm audit --prod --audit-level high",
    "lint": "eslint .",
    "types": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@eslint/js": "^9.39.5",
    "@sanity/eslint-config-studio": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-awscdk": "^4.4.4",
    "eslint-plugin-mdx": "^3.9.5",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.7",
    "eslint-plugin-turbo": "^2.11.11",
    "typescript-eslint": "^8.72.2"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
