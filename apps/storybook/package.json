    "@codedazur/react-pagination": "workspace:*",
    "@codedazur/react-parallax": "workspace:*",
    "@codedazur/react-preferences": "workspace:*",
    "@codedazur/react-select": "workspace:*",
    "@codedazur/react-tracking": "workspace:*",
    "@vanilla-extract/css": "^1.21.3",
