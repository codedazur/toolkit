  },
  "devDependencies": {
    "aws-cdk": "^2.1117.0",
    "dotenv": "^17.4.1",
    "ts-jest": "^29.4.9",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
