{
  "name": "@apps/cdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "audit": "npm audit --omit dev --audit-level high",
    "lint": "eslint .",
    "types": "tsc --noEmit",
