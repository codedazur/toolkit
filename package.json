{
  "name": "toolkit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "develop": "turbo run develop --parallel",
    "develop:packages": "turbo run develop --filter @codedazur/* --parallel",
    "audit": "pnpm audit --prod --audit-level high",
    "update": "pnpm dlx npm-check-updates@latest --interactive --format group --deep --upgrade --install never && pnpm install",
    "lint": "turbo run lint",
    "types": "turbo run types",
    "test": "turbo run test",
    "check": "turbo run audit lint types test",
    "check:apps": "pnpm run check --filter=@apps/*",
    "check:packages": "pnpm run check --filter=@codedazur/*",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "build": "turbo run build",
    "build:apps": "turbo run build --filter=@apps/*",
    "build:packages": "turbo run build --filter=@codedazur/*",
    "deploy": "turbo run deploy --filter=@apps/cdk",
    "destroy": "turbo run destroy --filter=@apps/cdk",
    "publish": "pnpm run build:packages && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "^2.31.1",
    "@codedazur/eslint-config": "workspace:*",
    "@codedazur/tsconfig": "workspace:*",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.5",
    "jsdom": "^29.1.1",
    "prettier": "latest",
    "tsup": "^8.5.1",
    "turbo": "^2.11.11",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
